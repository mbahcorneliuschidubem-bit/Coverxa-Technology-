}

.progress-track{
    height:9px;
    background:#e2e8f0;
    border-radius:20px;
    overflow:hidden;
}

.progress-fill{
    height:100%;
    background:#2563eb;
    transition:.3s;
}

@media(max-width:640px){

    .mobile-stack{
        flex-direction:column;
        align-items:stretch;
    }

    .mobile-stack button{
        width:100%;
        margin-bottom:8px;
    }

}

